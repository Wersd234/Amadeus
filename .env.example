# ===== Discord =====
DISCORD_BOT_TOKEN=your_token_here

# ===== LLM Backend (OpenAI-compatible) =====
# The bot does NOT send a model name — the server uses whatever is loaded.
# If your backend REQUIRES a model field, set one below; otherwise leave empty.
LLM_BASE_URL=http://192.168.0.58:1234/v1
LLM_API_KEY=123
LLM_MODEL_NAME=

# Vision support: auto-detected from LLM_MODEL_NAME (checks for "qwen").
# Set explicitly to override: true / false
# LLM_VISION_ENABLED=

LLM_CTX_SIZE=32768

# ===== Tavily Search API =====
# Sign up at https://tavily.com (free: 1,000 searches/month)
TAVILY_API_KEY=your_tavily_api_key_here

# ===== PTV Timetable API v3 =====
# Apply at: https://www.ptv.vic.gov.au/footer/data-and-reporting/datasets/ptv-timetable-api/
PTV_DEVELOPER_ID=your_developer_id_here
PTV_API_KEY=your_api_key_here

# ===== Worldline =====
WORLDLINE_REFRESH_HOURS=6
DMAIL_SHIFT_PROB=0.2

# ===== Free-Speaking Mode (群友自由发言) =====
# The bot occasionally jumps into conversations without being @mentioned.
# Set FREE_SPEAK_PROB=0 to disable this behaviour entirely.
# FREE_SPEAK_MSG_THRESHOLD=12
# FREE_SPEAK_COOLDOWN_MIN=8
# FREE_SPEAK_PROB=0.06

# ===== Timezone =====
TZ=Australia/Melbourne